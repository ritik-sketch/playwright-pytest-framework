{
  "info": {
    "name": "JSONPlaceholder - posts",
    "description": "Postman collection for the /posts resource. Runs in CI with Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }
  ],
  "item": [
    {
      "name": "List posts",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns 100 posts', () => pm.expect(pm.response.json().length).to.eql(100));",
              "pm.test('responds under 2s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get post 1",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/1" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has required fields', () => { pm.expect(body).to.have.all.keys('userId', 'id', 'title', 'body'); });",
              "pm.test('id is 1', () => pm.expect(body.id).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create post",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/posts",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": 1, \"title\": \"QA automation framework\", \"body\": \"Created by Newman in CI\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('new id assigned', () => pm.expect(pm.response.json().id).to.eql(101));",
              "pm.test('title echoed back', () => pm.expect(pm.response.json().title).to.eql('QA automation framework'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get unknown post",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/9999" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
